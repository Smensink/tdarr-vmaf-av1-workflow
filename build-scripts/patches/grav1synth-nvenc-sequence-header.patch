+    #[test]
+    fn parse_obu_sequence_header_write_preserves_nvenc_size_and_trailing_bits() {
+        // Sequence Header payload emitted by av1_nvenc for the production 10-bit
+        // fixture.  film_grain_params_present is the low bit of byte 13; byte 14
+        // is the separate AV1 trailing-bits byte.
+        let seq_payload = [
+            0x00, 0x00, 0x00, 0x62, 0xeb, 0xbf, 0xf1, 0xf8, 0x04, 0x33, 0xa1, 0x22, 0x01, 0x20,
+            0x80,
+        ];
+        let obu = build_obu_bytes(ObuType::SequenceHeader, None, true, &seq_payload);
+        let following_obu = build_obu_bytes(ObuType::Padding, None, true, &[0x55]);
+        let mut packet = obu.clone();
+        packet.extend_from_slice(&following_obu);
+        let mut parser = make_parser::<true>(0, false, None, Vec::new());
+        parser.incoming_grain_header = Some(Vec::new());
+
+        let (remaining, _) = parser
+            .parse_obu(&packet, 0)
+            .expect("should rewrite NVENC header");
+
+        assert_eq!(remaining, following_obu);
+        assert_eq!(parser.packet_out.len(), obu.len());
+        assert_eq!(parser.packet_out[1], seq_payload.len() as u8);
+        assert_eq!(parser.packet_out[2 + 13], 0x21);
+        assert_eq!(parser.packet_out[2 + 14], 0x80);
+
+        let (remaining, _) = parser
+            .parse_obu(remaining, 0)
+            .expect("following OBU boundary should remain intact");
+        assert!(remaining.is_empty());
+        assert_eq!(&parser.packet_out[obu.len()..], following_obu);
+
+        let mut read_parser = make_parser::<false>(0, false, None, Vec::new());
+        let (read_remaining, parsed) = read_parser
+            .parse_obu(&parser.packet_out, 0)
+            .expect("rewritten NVENC header should parse");
+        assert_eq!(read_remaining, following_obu);
+        let Some(Obu::SequenceHeader(header)) = parsed else {
+            panic!("expected rewritten sequence header");
+        };
+        assert!(header.film_grain_params_present);
+    }
+
+    #[test]
+    fn parse_obu_sequence_header_write_removes_grain_without_changing_nvenc_size() {
+        let mut seq_payload = [
+            0x00, 0x00, 0x00, 0x62, 0xeb, 0xbf, 0xf1, 0xf8, 0x04, 0x33, 0xa1, 0x22, 0x01, 0x20,
+            0x80,
+        ];
+        seq_payload[13] |= 1;
+        let obu = build_obu_bytes(ObuType::SequenceHeader, None, true, &seq_payload);
+        let mut parser = make_parser::<true>(0, false, None, Vec::new());
+
+        let (remaining, _) = parser
+            .parse_obu(&obu, 0)
+            .expect("should clear the NVENC grain-present flag");
+
+        assert!(remaining.is_empty());
+        assert_eq!(parser.packet_out.len(), obu.len());
+        assert_eq!(parser.packet_out[1], seq_payload.len() as u8);
+        assert_eq!(parser.packet_out[2 + 13], 0x20);
+        assert_eq!(parser.packet_out[2 + 14], 0x80);
+
+        let mut read_parser = make_parser::<false>(0, false, None, Vec::new());
+        let (read_remaining, parsed) = read_parser
+            .parse_obu(&parser.packet_out, 0)
+            .expect("rewritten NVENC header should parse");
+        assert!(read_remaining.is_empty());
+        let Some(Obu::SequenceHeader(header)) = parsed else {
+            panic!("expected rewritten sequence header");
+        };
+        assert!(!header.film_grain_params_present);
+    }
