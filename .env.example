# Copy to .env and populate locally. Never commit the populated file.
TZ=Etc/UTC
PUID=1000
PGID=1000

# The example compose binds both ports to loopback by default.
TDARR_WEB_PORT=8265
TDARR_SERVER_PORT=8266
TDARR_NODE_NAME=vmaf-node
NVIDIA_VISIBLE_DEVICES=all

# Required by the compose file for authenticated internal-node access.
# Generate a private value beginning with tapi_ and at least 14 characters.
TDARR_API_KEY=

# Fail closed by default. Set to 1 only for the first start of a new, empty
# database; import the canonical flow, reset to 0, and recreate immediately.
TDARR_FLOW_PARITY_BOOTSTRAP=0

# Optional metadata integrations. Leave blank to use filename-only metadata.
TDARR_PLEX_URL=http://host.docker.internal:32400
TDARR_PLEX_TOKEN=
TDARR_TMDB_API_KEY=
TDARR_TVDB_API_KEY=

# The tracked unmonitor plugin reads separate Radarr and Sonarr environment keys.
TDARR_RADARR_API_KEY=
TDARR_SONARR_API_KEY=

# Optional image/volume names.
TDARR_WORKFLOW_IMAGE=tdarr-vmaf-av1-workflow:local
TDARR_SQL_VOLUME=tdarr-db-sql
TDARR_VMAF_SCORE_VOLUME=tdarr-vmaf-v1-score
